@startuml
title SSD - UC04 Cancel booking

actor Resident as User
participant ":CondoSched" as System

User -> System : viewBookings()
System --> User: list of bookings

User -> System : selectBooking(bookingId)
System --> User: booking details

User -> System : cancelBooking(bookingId)
System --> User: request confirmation

User -> System : confirmCancellation()
System --> User: booking cancelled

@enduml