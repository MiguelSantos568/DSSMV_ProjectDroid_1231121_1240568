@startuml
hide empty methods

package "Modelos dos ecrãs" {
    class Habitation {
        unitId: long
        condominiumId: long
        buildingId: long
        condominium: String
        building: String
        floor: String
        unit: String
    }
    class HabitationProfile {
        unitId: long
        fullName: String
        email: String
    }
    class HomeSession {
        home: Habitation
        profile: HabitationProfile
    }
    class Amenity {
        id: long
        name: String
        description: String
        type: String
        buildingId: long
        buildingName: String
        requiresBooking: boolean
        capacity: int
        openingTime: LocalTime
        closingTime: LocalTime
        bookingFee: Double
        isActive: boolean
        rules: String
    }
    class Resident {
        id: long
        unitId: long
        firstName: String
        lastName: String
        isActive: boolean
    }
    class Booking {
        id: long
        unitId: long
        amenityId: long
        amenityName: String
        residentId: long
        startTime: String
        endTime: String
        status: String
        numberOfGuests: int
        fee: Double
        notes: String
        canCancel(): boolean
    }
}

HomeSession *-- Habitation
HomeSession *-- HabitationProfile
Booking ..> Habitation : unitId
Booking ..> Amenity : amenityId
Booking ..> Resident : residentId
Resident ..> Habitation : unitId

@enduml
