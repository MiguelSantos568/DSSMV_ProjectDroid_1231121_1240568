<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/page">
  <LinearLayout
    android:id="@+id/homeHeader"
    android:layout_width="0dp"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/page_padding"
    app:layout_constraintWidth_max="@dimen/content_width"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">
    <ImageButton
      android:id="@+id/homeMenuButton"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:padding="12dp"
      android:src="@drawable/ic_menu"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/open_menu" />
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/brand"
      android:textSize="24sp"
      android:textColor="@color/ink"
      android:gravity="center"
      android:fontFamily="sans-serif-medium" />
    <ImageView
      android:id="@+id/homeProfileImage"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:padding="12dp"
      android:background="@drawable/bg_avatar"
      android:src="@drawable/ic_person"
      android:clickable="true"
      android:focusable="true"
      android:contentDescription="@string/open_profile" />
  </LinearLayout>
  <ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    app:layout_constraintWidth_max="@dimen/content_width"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/homeHeader"
    app:layout_constraintBottom_toTopOf="@id/screenNavigation">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="@dimen/page_padding">
      <TextView
        style="@style/Text.Condo.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title" />
      <TextView
        style="@style/Text.Condo.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_body"
        android:layout_marginTop="8dp" />
      <LinearLayout
        android:id="@+id/homeCondoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="210dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_home_hero"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">
        <TextView
          style="@style/Text.Condo.Label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/home_label"
          android:textColor="@color/accent" />
        <TextView
          android:id="@+id/homeCondoName"
          style="@style/Text.Condo.Title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/on_hero"
          android:layout_marginTop="28dp" />
        <TextView
          android:id="@+id/homeUnitInfo"
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/hero_muted"
          android:layout_marginTop="8dp" />
        <ImageView
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:src="@drawable/ic_arrow"
          android:importantForAccessibility="no"
          android:layout_gravity="end"
          android:layout_marginTop="16dp"
          app:tint="@color/accent" />
      </LinearLayout>
      <TextView
        style="@style/Text.Condo.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/explore_title"
        android:layout_marginTop="32dp" />
      <TextView
        style="@style/Text.Condo.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/explore_body"
        android:layout_marginTop="6dp" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/button1"
        style="@style/Widget.Condo.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_amenities"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_leaf" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/button2"
        style="@style/Widget.Condo.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/credits"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_info" />
    </LinearLayout>
  </ScrollView>
  <include
    android:id="@+id/screenNavigation"
    layout="@layout/layout_bottom_navigation"
    android:layout_width="0dp"
    android:layout_height="80dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
