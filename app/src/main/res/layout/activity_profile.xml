<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F7FB">

    <!-- Top bar -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

        <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Menu" />

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Perfil"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1D3557" />

        <ImageView
                android:id="@+id/profileImage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@android:drawable/sym_def_app_icon"
                android:background="@android:color/transparent"
                android:contentDescription="Foto de perfil" />
    </LinearLayout>

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <!-- Card principal -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="#FFFFFF"
                    android:padding="24dp"
                    android:layout_marginBottom="16dp">

                <ImageView
                        android:id="@+id/profileBigImage"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@android:drawable/sym_def_app_icon"
                        android:contentDescription="Foto de perfil grande" />

                <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome do Residente"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1D3557"
                        android:layout_marginTop="12dp" />

                <TextView
                        android:id="@+id/profileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="email@exemplo.com"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Dados do perfil -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="20dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informações do residente"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1D3557"
                        android:layout_marginBottom="16dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Condomínio"
                        android:textStyle="bold"
                        android:textColor="#374151" />

                <TextView
                        android:id="@+id/profileCondominium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Condo A"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="12dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prédio"
                        android:textStyle="bold"
                        android:textColor="#374151" />

                <TextView
                        android:id="@+id/profileBuilding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Building A"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="12dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Andar"
                        android:textStyle="bold"
                        android:textColor="#374151" />

                <TextView
                        android:id="@+id/profileFloor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="12dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Porta"
                        android:textStyle="bold"
                        android:textColor="#374151" />

                <TextView
                        android:id="@+id/profileUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="111"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="20dp" />

                <Button
                        android:id="@+id/editProfileButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Editar perfil" />

                <Button
                        android:id="@+id/logoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/logout" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra de navegação inferior -->
    <include
            layout="@layout/layout_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="76dp" />
</LinearLayout>
