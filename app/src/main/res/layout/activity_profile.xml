<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/page">
  <ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    app:layout_constraintWidth_max="@dimen/content_width"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toTopOf="@id/screenNavigation">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="@dimen/page_padding">
      <TextView
        style="@style/Text.Condo.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_profile" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card"
        android:layout_marginTop="24dp">
        <ImageView
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:src="@drawable/ic_person"
          android:importantForAccessibility="no"
          android:padding="16dp"
          android:background="@drawable/bg_avatar" />
        <TextView
          style="@style/Text.Condo.Label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/shared_contact"
          android:layout_marginTop="20dp" />
        <TextView
          android:id="@+id/profileName"
          style="@style/Text.Condo.Section"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp" />
        <TextView
          android:id="@+id/profileEmail"
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp" />
        <TextView
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/profile_note"
          android:layout_marginTop="20dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card"
        android:layout_marginTop="16dp">
        <TextView
          style="@style/Text.Condo.Section"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/home_details" />
        <TextView
          style="@style/Text.Condo.Label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/condominium"
          android:layout_marginTop="20dp" />
        <TextView
          android:id="@+id/profileCondominium"
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/ink"
          android:layout_marginTop="4dp" />
        <TextView
          style="@style/Text.Condo.Label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/building_label"
          android:layout_marginTop="20dp" />
        <TextView
          android:id="@+id/profileBuilding"
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/ink"
          android:layout_marginTop="4dp" />
        <TextView
          style="@style/Text.Condo.Label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/floor_label"
          android:layout_marginTop="20dp" />
        <TextView
          android:id="@+id/profileFloor"
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/ink"
          android:layout_marginTop="4dp" />
        <TextView
          style="@style/Text.Condo.Label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/unit_label"
          android:layout_marginTop="20dp" />
        <TextView
          android:id="@+id/profileUnit"
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/ink"
          android:layout_marginTop="4dp" />
      </LinearLayout>
        <TextView
                android:id="@+id/profileLanguage"
                style="@style/Text.Condo.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:layout_marginTop="4dp" />
        <com.google.android.material.button.MaterialButton
                android:id="@+id/languageButton"
                style="@style/Widget.Condo.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/changeLanguage"
                android:layout_marginTop="12dp" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutButton"
        style="@style/Widget.Condo.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logout"
        android:layout_marginTop="16dp" />
    </LinearLayout>
  </ScrollView>
  <include
    android:id="@+id/screenNavigation"
    layout="@layout/layout_bottom_navigation"
    android:layout_width="0dp"
    android:layout_height="80dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>