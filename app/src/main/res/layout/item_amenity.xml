<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="24dp"
  android:background="@drawable/bg_card" android:foreground="?attr/selectableItemBackground">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical">
    <ImageView
      android:id="@+id/amenityIcon"
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:padding="13dp"
      android:background="@drawable/bg_avatar"
      android:src="@drawable/ic_leaf"
      android:importantForAccessibility="no" />
    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginStart="16dp">
      <TextView
        android:id="@+id/amenityName"
        style="@style/Text.Condo.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
      <TextView
        android:id="@+id/amenityBuilding"
        style="@style/Text.Condo.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
    </LinearLayout>
  </LinearLayout>
  <TextView
    android:id="@+id/amenityDescription"
    style="@style/Text.Condo.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp" />
  <TextView
    android:id="@+id/amenityHours"
    style="@style/Text.Condo.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:textColor="@color/ink" />
  <TextView
    android:id="@+id/amenityCapacity"
    style="@style/Text.Condo.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp" />
  <TextView
    android:id="@+id/amenityBooking"
    style="@style/Text.Condo.Label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:background="@drawable/bg_badge"
    android:textColor="@color/primary" />
  <TextView
    style="@style/Text.Condo.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="@string/detail_open"
    android:textColor="@color/primary"
    app:drawableEndCompat="@drawable/ic_arrow"
    android:drawablePadding="12dp" /></LinearLayout>
