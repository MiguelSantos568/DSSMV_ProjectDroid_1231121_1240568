<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/page">
  <ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    app:layout_constraintWidth_max="@dimen/content_width"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="@dimen/page_padding">
      <TextView
        style="@style/Text.Condo.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/qr_eyebrow"
        android:layout_marginTop="24dp" />
      <TextView
        style="@style/Text.Condo.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/qr_title"
        android:layout_marginTop="16dp" />
      <TextView
        style="@style/Text.Condo.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/qr_body"
        android:layout_marginTop="12dp" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card"
        android:layout_marginTop="32dp">
        <ImageView
          android:layout_width="112dp"
          android:layout_height="112dp"
          android:src="@drawable/ic_qr"
          android:importantForAccessibility="no"
          android:layout_gravity="center_horizontal"
          android:layout_marginVertical="28dp" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/scanQrButton"
          style="@style/Widget.Condo.Button"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/qr_scan"
          android:layout_marginTop="16dp"
          app:icon="@drawable/ic_qr" />
        <TextView
          android:id="@+id/qrStatus"
          style="@style/Text.Condo.Body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/qr_ready"
          android:gravity="center"
          android:layout_marginTop="20dp"
          android:accessibilityLiveRegion="polite" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>