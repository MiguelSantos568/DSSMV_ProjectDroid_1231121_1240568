<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/page_padding">
        <com.google.android.material.button.MaterialButton android:id="@+id/bookingBack"
            style="@style/Widget.Condo.Button.Outline" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/back" />
        <TextView style="@style/Text.Condo.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/booking_title" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/bookingAmenity" style="@style/Text.Condo.Section"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/bookingHours" style="@style/Text.Condo.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/bookingCapacity" style="@style/Text.Condo.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/bookingFee" style="@style/Text.Condo.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView style="@style/Text.Condo.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/booking_intro" android:layout_marginTop="16dp" />
        <TextView style="@style/Text.Condo.Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/booking_resident"
            android:labelFor="@id/bookingResident" android:layout_marginTop="24dp" />
        <Spinner android:id="@+id/bookingResident" android:layout_width="match_parent"
            android:layout_height="56dp" android:spinnerMode="dropdown" />
        <com.google.android.material.button.MaterialButton android:id="@+id/bookingRetry"
            style="@style/Widget.Condo.Button.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/retry_amenities" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/bookingDate"
            style="@style/Widget.Condo.Button.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/bookingStart"
            style="@style/Widget.Condo.Button.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/bookingEnd"
            style="@style/Widget.Condo.Button.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/booking_people" android:layout_marginTop="16dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/bookingPeople"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:maxLength="6" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/booking_notes" android:layout_marginTop="16dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/bookingNotes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine" android:maxLength="500" android:maxLines="4" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/bookingStatus" style="@style/Text.Condo.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/bookingSubmit"
            style="@style/Widget.Condo.Button" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/booking_submit" android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/bookingViewList"
            style="@style/Widget.Condo.Button.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/view_bookings" />
    </LinearLayout>
</ScrollView>
