<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style
    name="Base.Theme.CondoSched"
    parent="Theme.Material3.DayNight.NoActionBar">
    <item
      name="colorPrimary">@color/primary</item>
    <item
      name="colorOnPrimary">@color/on_primary</item>
    <item
      name="colorSecondary">@color/primary</item>
    <item
      name="colorSurface">@color/surface</item>
    <item
      name="colorOnSurface">@color/ink</item>
    <item
      name="android:colorBackground">@color/page</item>
    <item
      name="android:windowBackground">@color/page</item>
    <item
      name="android:statusBarColor">@color/page</item>
    <item
      name="android:navigationBarColor">@color/hero</item>
    <item
      name="android:windowLightStatusBar">true</item>
    <item
      name="android:fontFamily">sans-serif</item>
    <item
      name="android:textColorPrimary">@color/ink</item>
    <item
      name="android:textColorSecondary">@color/muted</item>
  </style>
  <style
    name="Theme.CondoSched"
    parent="Base.Theme.CondoSched" />
  <style
    name="Text.Condo.Title"
    parent="android:Widget.TextView">
    <item
      name="android:textSize">30sp</item>
    <item
      name="android:textColor">@color/ink</item>
    <item
      name="android:fontFamily">sans-serif-medium</item>
    <item
      name="android:lineSpacingExtra">3dp</item>
  </style>
  <style
    name="Text.Condo.Section"
    parent="Text.Condo.Title">
    <item
      name="android:textSize">21sp</item>
  </style>
  <style
    name="Text.Condo.Body"
    parent="android:Widget.TextView">
    <item
      name="android:textSize">15sp</item>
    <item
      name="android:textColor">@color/muted</item>
    <item
      name="android:lineSpacingExtra">4dp</item>
  </style>
  <style
    name="Text.Condo.Label"
    parent="Text.Condo.Body">
    <item
      name="android:textSize">12sp</item>
    <item
      name="android:fontFamily">sans-serif-medium</item>
    <item
      name="android:letterSpacing">0.08</item>
  </style>
  <style
    name="Widget.Condo.Button"
    parent="Widget.Material3.Button">
    <item
      name="cornerRadius">18dp</item>
    <item
      name="android:minHeight">56dp</item>
    <item
      name="android:insetTop">0dp</item>
    <item
      name="android:insetBottom">0dp</item>
    <item
      name="android:textSize">15sp</item>
    <item
      name="android:textAllCaps">false</item>
  </style>
  <style
    name="Widget.Condo.Button.Outline"
    parent="Widget.Material3.Button.OutlinedButton">
    <item
      name="cornerRadius">18dp</item>
    <item
      name="android:minHeight">56dp</item>
    <item
      name="strokeColor">@color/border</item>
    <item
      name="android:textAllCaps">false</item>
  </style>
</resources>
